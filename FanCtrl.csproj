<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>FanCtrl</RootNamespace>
		<AssemblyName>FanCtrl</AssemblyName>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\icon.ico</ApplicationIcon>
		<Platforms>AnyCPU;x64</Platforms>
		<StartupObject>FanCtrl.Program</StartupObject>

		<!-- Метаданные сборки -->
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Version>1.0.0</Version>
		<Title>FanCtrl</Title>
		<AssemblyTitle>FanCtrl</AssemblyTitle>
		<AssemblyDescription>Intelligent fan control with AI assistance</AssemblyDescription>
		<Company>MPlusPlus</Company>
		<Product>FanCtrl</Product>
		<Copyright>Copyright © 2024</Copyright>
		<Trademark></Trademark>
		<AssemblyCulture></AssemblyCulture>
		<ComVisible>false</ComVisible>
	</PropertyGroup>

	<!-- ===== ИСКЛЮЧЕНИЯ: тестовый код, лишние файлы ===== -->
	<ItemGroup>
		<Compile Remove="docks\**\*" />
		<Compile Remove="stress.**\**\*.cs" />
		<Compile Remove="Benchmarking\**\*.cs" />
		<Compile Remove="Benchmarker\**\*.cs" />
		<Compile Remove="**\*Tests.cs" />
		<Compile Remove="**\AssemblyInfo.cs" />
		<EmbeddedResource Remove="docks\**\*" />
		<None Remove="docks\**\*" />
	</ItemGroup>

	<!-- ===== ЗАМЕНИМЫЕ ЗАВИСИМОСТИ (через NuGet) ===== -->
	<ItemGroup>
		<!-- HID / USB -->
		<PackageReference Include="HidSharp" Version="2.6.4" />

		<!-- Планировщик задач -->
		<PackageReference Include="TaskScheduler" Version="2.10.1" />

		<!-- JSON / Парсинг -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="System.Text.Json" Version="8.0.0" />
		<PackageReference Include="HtmlAgilityPack" Version="1.11.57" />

		<!-- Аргументы командной строки -->
		<PackageReference Include="CommandLineParser" Version="2.9.1" />

		<!-- Логирование / Утилиты -->
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
		<PackageReference Include="ShellProgressBar" Version="5.2.0" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />

		<!-- Тестирование (xUnit) -->
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="xunit" Version="2.6.6" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<!-- MSBuild (если нужен для задач сборки) -->
		<PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.8.3" />
		<PackageReference Include="Microsoft.Build.Framework" Version="17.8.3" />

		<!-- Системные пакеты -->
		<PackageReference Include="System.Management" Version="10.0.2" />
		<PackageReference Include="System.Resources.Extensions" Version="8.0.0" />

		<!-- Информация о железе -->
		<PackageReference Include="HardwareInformation" Version="4.4.0" />
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />

		<!-- LLamaSharp + CUDA -->
		<PackageReference Include="LLamaSharp" Version="0.12.0" />
		<PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.12.0" />
	</ItemGroup>

	<!-- ===== НЕЗАМЕНИМЫЕ ЗАВИСИМОСТИ (локальные DLL) ===== -->
	<ItemGroup>
		<!-- DarkUI - нет на NuGet -->
		<Reference Include="DarkUI">
			<HintPath>dll\DarkUI.dll</HintPath>
			<Private>True</Private>
		</Reference>

		<!-- NvAPIWrapper - нет на NuGet -->
		<Reference Include="NvAPIWrapper">
			<HintPath>dll\NvAPIWrapper.dll</HintPath>
			<Private>True</Private>
		</Reference>

		<!-- ZedGraph - нет на официальном NuGet -->
		<Reference Include="ZedGraph">
			<HintPath>dll\ZedGraph.dll</HintPath>
			<Private>True</Private>
		</Reference>
	</ItemGroup>

	<!-- ===== РЕСУРСЫ И ФАЙЛЫ ===== -->
	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Update="Resources\StringLib.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>StringLib.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\StringLib.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>StringLib.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="src\models\gemma-4-E2B-it-Q4_K_M.gguf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="src\models\json.gbnf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- ===== СОБЫТИЯ СБОРКИ ===== -->
	<PropertyGroup>
		<PreBuildEvent>
			del /Q "$(TargetDir)FanCtrl.dll" "$(TargetDir)FanCtrl.exe" 2&gt;nul
		</PreBuildEvent>
		<PostBuildEvent>
			powershell -Command "Copy-Item -Path '$(SolutionDir)dll\DarkUI.dll' -Destination '$(TargetDir)' -Force -ErrorAction SilentlyContinue"
			powershell -Command "Copy-Item -Path '$(SolutionDir)dll\NvAPIWrapper.dll' -Destination '$(TargetDir)' -Force -ErrorAction SilentlyContinue"
			powershell -Command "Copy-Item -Path '$(SolutionDir)dll\ZedGraph.dll' -Destination '$(TargetDir)' -Force -ErrorAction SilentlyContinue"
		</PostBuildEvent>
	</PropertyGroup>

</Project>